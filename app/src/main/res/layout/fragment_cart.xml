<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    xmlns:tools1="http://schemas.android.com/tools"
    android:background="#F9FAFB"
    android:fitsSystemWindows="true"
    android:id="@+id/coordinatorLayout"
    android:layout_height="match_parent"
    tools:context=".Fragments.CartFragment">


    <androidx.coordinatorlayout.widget.CoordinatorLayout

        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/paymentcard1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F9FAFB"
            app:elevation="4dp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginHorizontal="16dp"
                android:layout_width="match_parent"
                android:id="@+id/title_card"
                android:layout_marginBottom="6dp"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="noScroll">


                <ImageView
                    android:background="@drawable/bg_search"
                    android:id="@+id/back_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_back"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#111111" />


                <TextView
                    android:id="@+id/tv_cart_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Cart"
                    android:textColor="@color/primaryGreenColor"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/btn_wishlist"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_search"
                    android:src="@drawable/ic_wishlist"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#111111" />
            </androidx.constraintlayout.widget.ConstraintLayout>




        </com.google.android.material.appbar.AppBarLayout>


        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView
                    android:paddingTop="6dp"
                    android:visibility="visible"
                    android:id="@+id/rv_cart_recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="150dp"
                    android:layout_marginHorizontal="8dp"
                    android:nestedScrollingEnabled="false"
                    tools1:listitem="@layout/cart_adapter" />

                <LinearLayout
                    android:visibility="gone"
                    android:id="@+id/layoutEmptyCart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:visibility="gone"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_cart"
                        app:tint="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No Cart Recorded Yet"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cart any Products and products will appear here."
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>





        </androidx.core.widget.NestedScrollView>


    </androidx.coordinatorlayout.widget.CoordinatorLayout>




    <LinearLayout
        android:elevation="18dp"
       android:background="@drawable/bg_search"
        android:layout_marginBottom="40dp"
        android:id="@+id/paymentcard1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/paymentcard"
            android:visibility="visible"
            android:paddingTop="10dp"
            android:paddingBottom="3dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="1dp"
            android:backgroundTint="#F9FAFB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/total_Price_and_item_cout_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Total Price (0 items)"
                    android:textColor="@color/lighter_dark"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/total_price_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rs. 0.0"
                    android:textColor="@color/lighter_dark"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <RelativeLayout
                android:visibility="gone"
                style="@style/PriceDetailRow">


                <TextView
                    style="@style/PriceDetailLabel"
                    android:text="Discount" />


                <TextView
                    android:id="@+id/discount_tv"
                    style="@style/PriceDetailValue"
                    android:text="- Rs: 0.0"
                    android:textColor="#00A36C" />


            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <!-- Left Side: Label & Info Icon Group -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PriceDetailLabel"
                        android:text="Delivery Charges" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="17dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_cash_on_delevery" />

                </LinearLayout>

                <!-- Right Side: Price Value -->
                <TextView
                    android:id="@+id/delivery_charges"
                    style="@style/PriceDetailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="#00A36C"
                    android:textStyle="bold" />

            </LinearLayout>


        </LinearLayout>


        <Button
            android:id="@+id/btnBuyPruductCart"
            android:layout_marginTop="2dp"
            android:textStyle="bold"
            android:textSize="16dp"
            android:textAllCaps="false"
            android:layout_marginBottom="25dp"
            android:layout_marginHorizontal="13dp"
            android:layout_width="match_parent"
            android:elevation="0dp"
            android:layout_height="47dp"
            android:background="@drawable/orange_button_bg"
            android:text="Proceed to Checkout"
            android:textColor="@color/white" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

