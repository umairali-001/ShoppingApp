<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".Fragments.CategoryFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:paddingHorizontal="5dp"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/top_title"

                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="40dp"
                    android:layout_width="match_parent"
                    android:layout_height="42dp">


                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="Categories"
                        android:textColor="@color/primaryGreenColor"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <ImageView
                    android:id="@+id/btn_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="18dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_search"
                    app:layout_constraintBottom_toBottomOf="@id/tv_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_title"
                    app:tint="#111111" />
                </androidx.constraintlayout.widget.ConstraintLayout>





                <View
                    android:id="@+id/divider_top"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    app:layout_constraintTop_toBottomOf="@id/top_title" />


                <androidx.core.widget.NestedScrollView
                    android:id="@+id/rv_sidebar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="200dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_top">

                    <LinearLayout
                        android:layout_width="110dp"
                        android:layout_height="0dp"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/divider_top">


                        <androidx.cardview.widget.CardView
                            app:cardBackgroundColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">


                            <LinearLayout
                                android:id="@+id/category_fashion_btn"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_category"
                                android:backgroundTint="@color/primaryGreenColor"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_fashion_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12dp"
                                    android:src="@drawable/ic_fashion_category1" />

                                <TextView
                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="Fashion"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView
                            app:cardBackgroundColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_electronic_btn"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_Electronic_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12dp"
                                    android:src="@drawable/ic_electronic_category1" />

                                <TextView
                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="Electric"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            app:cardBackgroundColor="@color/white"
                            android:layout_height="35dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_home_btn"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_home_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12dp"
                                    android:src="@drawable/ic_home_category1" />

                                <TextView

                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="Home"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView
                            app:cardBackgroundColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_beauty_btn"

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_beauty_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12sp"
                                    android:src="@drawable/ic_beauty_category1" />

                                <TextView

                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="Beauty"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView

                            app:cardBackgroundColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_sport_btn"

                                android:layout_width="match_parent"
                                android:layout_height="35dp"

                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_sport_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12dp"
                                    android:src="@drawable/ic_sport_category1" />

                                <TextView

                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="Sports"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />


                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView
                            app:cardBackgroundColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_books_btn"

                                android:layout_width="match_parent"
                                android:layout_height="35dp"

                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_books_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12dp"
                                    android:src="@drawable/ic_books_category1" />

                                <TextView

                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="Books"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView
                            app:cardBackgroundColor="@color/white"

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_toys_btn"

                                android:layout_width="match_parent"
                                android:layout_height="35dp"

                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_toys_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12dp"
                                    android:src="@drawable/ic_toys_category1" />

                                <TextView

                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="Toys"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView
                            app:cardBackgroundColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_automotive_btn"

                                android:layout_width="match_parent"
                                android:layout_height="35dp"

                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_automotive_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12dp"
                                    android:src="@drawable/ic_automotive_category1" />

                                <TextView
                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"

                                    android:text="Automo.."
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />


                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="2dp"
                            android:background="#08000000" />

                        <androidx.cardview.widget.CardView

                            app:cardBackgroundColor="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_marginVertical="4dp"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:id="@+id/category_petFood_btn"
                                android:layout_width="match_parent"
                                android:layout_height="35dp"

                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/iv_pet_icon"
                                    android:layout_width="25dp"
                                    android:layout_height="25dp"
                                    android:layout_marginStart="12sp"
                                    android:src="@drawable/ic_pet_food_category1" />

                                <TextView
                                    android:layout_width="67dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="4dp"
                                    android:text="PetFood"
                                    android:textColor="#383737"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />


                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#08000000" />


                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>



                <View
                    android:id="@+id/vertical_divider"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="3dp"
                    android:background="#EBEAEAEA"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/rv_sidebar"
                    app:layout_constraintTop_toBottomOf="@id/divider_top" />


                <androidx.core.widget.NestedScrollView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/vertical_divider"
                    app:layout_constraintTop_toBottomOf="@id/divider_top">



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingVertical="10dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="4dp">

                        <androidx.cardview.widget.CardView
                            android:layout_marginHorizontal="5dp"
                            app:cardBackgroundColor="#E1E1E2"
                            android:layout_width="match_parent"
                            app:cardCornerRadius="10dp"
                            android:layout_height="130dp">
                            <ImageView
                                android:scaleType="centerCrop"
                                android:id="@+id/trendingImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                        </androidx.cardview.widget.CardView>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sub Categories"
                                android:textColor="@color/primaryGreenColor"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">


                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#F4F4F4"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="2dp"
                                    app:cardUseCompatPadding="true">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:backgroundTint="#D1CACA"
                                        android:orientation="vertical">


                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            app:cardBackgroundColor="#E1E1E2"
                                            app:cardCornerRadius="10dp">


                                            <ImageView
                                                android:id="@+id/mensClothing"
                                                android:layout_width="match_parent"
                                                android:layout_height="100dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/images_3" />
                                        </androidx.cardview.widget.CardView>


                                        <TextView
                                            android:id="@+id/firstTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="25dp"
                                            android:gravity="center"
                                            android:text="Men's Cloth"
                                            android:textColor="#403F3F"
                                            android:textSize="14dp"

                                            android:textStyle="bold" />

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#F4F4F4"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="2dp"
                                    app:cardUseCompatPadding="true">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:backgroundTint="#D9D7D7"
                                        android:orientation="vertical">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            app:cardBackgroundColor="#E1E1E2"
                                            app:cardCornerRadius="10dp">

                                            <ImageView
                                                android:id="@+id/womenClothing"
                                                android:layout_width="match_parent"
                                                android:layout_height="100dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/images_3" />
                                        </androidx.cardview.widget.CardView>

                                        <TextView
                                            android:id="@+id/secondTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="25dp"
                                            android:gravity="center"
                                            android:text="Men's Cloth"
                                            android:textColor="#403F3F"
                                            android:textSize="14dp"
                                            android:textStyle="bold" />


                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">


                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#F4F4F4"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="2dp"
                                    app:cardUseCompatPadding="true">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:backgroundTint="#B3B3B3"
                                        android:orientation="vertical">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            app:cardBackgroundColor="#E1E1E2"
                                            app:cardCornerRadius="10dp">

                                            <ImageView
                                                android:id="@+id/kidsClothing"
                                                android:layout_width="match_parent"
                                                android:layout_height="100dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/images_3" />
                                        </androidx.cardview.widget.CardView>

                                        <TextView
                                            android:id="@+id/thirdTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="25dp"
                                            android:gravity="center"
                                            android:text="Men's Cloth"
                                            android:textColor="#403F3F"
                                            android:textSize="14dp"
                                            android:textStyle="bold" />

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#F4F4F4"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="2dp"
                                    app:cardUseCompatPadding="true">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:backgroundTint="#B3B3B3"
                                        android:orientation="vertical">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            app:cardBackgroundColor="#E1E1E2"
                                            app:cardCornerRadius="10dp">

                                            <ImageView
                                                android:id="@+id/footwear"
                                                android:layout_width="match_parent"
                                                android:layout_height="100dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/images_3" />
                                        </androidx.cardview.widget.CardView>

                                        <TextView
                                            android:id="@+id/fourthTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="25dp"
                                            android:gravity="center"
                                            android:text="Men's Cloth"
                                            android:textColor="#403F3F"
                                            android:textSize="14dp"
                                            android:textStyle="bold" />


                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">


                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#F4F4F4"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="2dp"
                                    app:cardUseCompatPadding="true">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:backgroundTint="#B3B3B3"
                                        android:orientation="vertical">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            app:cardBackgroundColor="#E1E1E2"
                                            app:cardCornerRadius="10dp">

                                            <ImageView
                                                android:id="@+id/watches"
                                                android:layout_width="match_parent"
                                                android:layout_height="100dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/images_3" />

                                        </androidx.cardview.widget.CardView>

                                        <TextView
                                            android:id="@+id/fifthTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="25dp"
                                            android:gravity="center"
                                            android:text="Men's Cloth"
                                            android:textColor="#403F3F"
                                            android:textSize="14dp"
                                            android:textStyle="bold" />

                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#F4F4F4"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="2dp"
                                    app:cardUseCompatPadding="true">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:backgroundTint="#B3B3B3"
                                        android:orientation="vertical">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            app:cardBackgroundColor="#E1E1E2"
                                            app:cardCornerRadius="10dp">

                                            <ImageView
                                                android:id="@+id/jewelry"
                                                android:layout_width="match_parent"
                                                android:layout_height="100dp"
                                                android:scaleType="centerCrop"
                                                android:src="@drawable/images_3" />
                                        </androidx.cardview.widget.CardView>

                                        <TextView
                                            android:id="@+id/sixthTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="25dp"
                                            android:gravity="center"
                                            android:text="Men's Cloth"
                                            android:textColor="#403F3F"
                                            android:textSize="14dp"
                                            android:textStyle="bold" />


                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>


                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>