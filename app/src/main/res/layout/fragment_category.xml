<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_screen_background">

    <!-- Top AppBar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/categoryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_screen_background"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSearchCategory"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_gravity="center"
                android:id="@+id/tvCategoryHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textColor="@color/primaryGreenColor"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnSearchCategory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_search"
            android:contentDescription="Search"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0F172A" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Quick Search Pill -->


    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/categoryHeader" />

    <!-- Two-Pane Main Layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginBottom="60dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <!-- Left Navigation Rail (Categories List) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryNav"
            android:paddingTop="10dp"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:background="#F8FAFC"
            android:clipToPadding="false"
            android:paddingBottom="90dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/item_category_nav" />

        <View
            android:id="@+id/railDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E2E8F0"
            app:layout_constraintStart_toEndOf="@id/rvCategoryNav" />

        <!-- Right Content Area (Subcategories & Popular Products) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollCategoryContent"
            android:layout_width="0dp"
            android:background="@color/primary_screen_background"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/railDivider"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp"
                android:layout_marginBottom="90dp">

                <!-- Hero Banner Card -->
                <androidx.cardview.widget.CardView
                    android:layout_margin="8dp"
                    android:id="@+id/cardCategoryHeroBanner"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivCategoryHero"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/image_1" />

                        <!-- Dark Scrim Gradient -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#3A000000" />

                        <!-- Banner Text & Action -->
                        <LinearLayout

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvCategoryBannerTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fashion Collection"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Explore All Products"
                                    android:textColor="#E0F2F1"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:rotation="180"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/ic_back"
                                    app:tint="#FFFFFF" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Subcategories Header -->
                <RelativeLayout
                    android:layout_marginHorizontal="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvSubcategoriesTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subcategories"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubcategoriesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="6 items"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </RelativeLayout>

                <!-- Subcategories Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSubCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_subcategory_grid" />

                <!-- Popular in this category Header -->
                <RelativeLayout
                    android:layout_marginHorizontal="10dp"
                    android:id="@+id/layoutPopularHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvPopularCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Popular in Fashion"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnViewAllCategoryProducts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="See All"
                        android:textColor="@color/primaryGreenColor"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Popular Products Horizontal Recycler -->
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_marginStart="6dp"
                    android:id="@+id/rvCategoryPopularProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    tools:listitem="@layout/item_category_product_compact" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>